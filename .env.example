APP_NAME="PDF to Markdown"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# Variabel WAJIB untuk produksi (Render/Railway)
# ---------------------------------------------------------------------------
# File .env TIDAK ikut ke dalam image Docker, jadi semua nilai produksi
# diset sebagai environment variable di dashboard Platform.
#
# Wajib diisi:
#   APP_ENV=production        supaya APP_DEBUG diabaikan dan pesan error
#                             tidak pernah ditampilkan ke pengguna
#   APP_DEBUG=false            WAJIB false di produksi. true membocorkan path
#                             server, nama kelas, dan potongan isi file
#   APP_KEY=base64:...        wajib ada. Tanpa ini, container berhenti sendiri
#                             di docker/entrypoint.sh dengan exit 1.
#                             Catatan: `php artisan config:cache` sendiri TIDAK
#                             gagal tanpa APP_KEY, jadi jangan mengandalkan
#                             perintah itu sebagai penjaga.
#                             Buat dengan: php artisan key:generate --show
#   APP_URL=https://nama-aplikasi.onrender.com   dipakai untuk URL absolut
#
# Nilai di bawah ini sudah sesuai untuk produksi:
#   CACHE_STORE=file
#   SESSION_DRIVER=file
# CACHE_STORE=file
# SESSION_DRIVER=file

# ---------------------------------------------------------------------------
# Trusted proxies
# ---------------------------------------------------------------------------
# Kosong (default) = TIDAK ADA proxy yang dipercaya, sehingga header
# X-Forwarded-For dari siapa pun diabaikan. Ini yang paling aman untuk
# pengembangan lokal, dan juga default yang benar kalau aplikasi diakses
# langsung tanpa proxy.
#
# Di Render/Railway, aplikasi HANYA bisa dijangkau lewat proxy platform, dan
# nomor port aslinya tidak pernah terlihat. Karena itu isilah dengan "*"
# supaya Laravel membaca alamat asli client dari header proxy:
#
#     TRUSTED_PROXIES=*
#
# Peringatan: "*" berarti semua proxy dipercaya. Kalau aplikasi Anda
# someday bisa diakses langsung (tidak lewat proxy), nilai "*" membuat
# siapa pun bisa memalsukan X-Forwarded-For, dan rate limit 10 konversi per
# menit kehilangan artinya.
#
# Untuk daftar IP proxy tertentu, pisahkan dengan koma:
#     TRUSTED_PROXIES=10.0.0.1,10.0.0.2
TRUSTED_PROXIES=

# ---------------------------------------------------------------------------
# Session cookie
# ---------------------------------------------------------------------------
# session.cookie_secure hanya dibaca di dalam container Docker, lewat
# docker/entrypoint.sh yang menuliskan nilainya ke php.ini saat start.
#
#   1 -> cookie hanya dikirim lewat HTTPS. Benar untuk Render/Railway (default)
#   0 -> cookie juga dikirim lewat HTTP biasa. WAJIB untuk pengujian lokal
#        lewat http://localhost, karena kalau tidak session tidak akan pernah
#        terkirim dan halaman akan terlihat seperti selalu gagal login.
#
# Nilai selain 0 atau 1 diabaikan dan diganti 1, supaya salah konfigurasi tidak
# diam-diam membuat cookie berjalan tanpa proteksi.
SESSION_SECURE_COOKIE=1

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# CATATAN: aplikasi ini TIDAK memakai database sama sekali. Tidak ada model,
# migration, atau query yang dipakai. Konversi berjalan sepenuhnya di memori
# dan hasilnya disimpan sementara di cache.
#
# Baris di bawah dibiarkan dari skeleton Laravel agar `php artisan` tetap
# jalan normal, dan supaya mudah ditambahkan nanti (mis. untuk riwayat file).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

# ---------------------------------------------------------------------------
# Session
# ---------------------------------------------------------------------------
# Session hanya menyimpan KUNCI acak hasil konversi (kurang dari 40 karakter).
# Isi Markdown-nya sendiri disimpan di cache, bukan di session, karena cookie
# session hanya bisa menampung sekitar 4 KB.
SESSION_DRIVER=file
SESSION_LIFETIME=120

# ---------------------------------------------------------------------------
# Cache
# ---------------------------------------------------------------------------
# Cache dipakai untuk menyimpan hasil konversi selama 15 menit.
#
# - "file"  : paling aman untuk hosting sederhana, tidak butuh server tambahan
# - "redis" : lebih baik untuk jumlah request tinggi
# - "array" : hanya untuk testing (data hilang tiap request)
CACHE_DRIVER=file
CACHE_STORE=file
CACHE_PREFIX=pdf-md-cache

# ---------------------------------------------------------------------------
# Batas upload
# ---------------------------------------------------------------------------
# Batas 15 MB ditegakkan oleh aplikasi (ConvertPdfRequest). Nilai di bawah ini
# adalah batas maksimal PHP, yang TIDAK BOLEH lebih kecil dari 15 MB, kalau
# tidak upload besar akan ditolak oleh PHP sebelum sampai ke aplikasi.
#
# Mengubah nilai ini berarti mengubah php.ini atau .htaccess milik server,
# bukan file .env.
# upload_max_filesize=15M
# post_max_size=16M

BROADCAST_DRIVER=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Frontend (Vite)
# ---------------------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"