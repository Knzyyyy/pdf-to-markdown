APP_NAME="PDF to Markdown"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# CATATAN: aplikasi ini TIDAK memakai database sama sekali. Tidak ada model,
# migration, atau query yang dipakai. Konversi berjalan sepenuhnya di memori
# dan hasilnya disimpan sementara di cache.
#
# Baris di bawah dibiarkan dari skeleton Laravel agar `php artisan` tetap
# jalan normal, dan supaya mudah ditambahkan nanti (mis. untuk riwayat file).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

# ---------------------------------------------------------------------------
# Session
# ---------------------------------------------------------------------------
# Session hanya menyimpan KUNCI acak hasil konversi (kurang dari 40 karakter).
# Isi Markdown-nya sendiri disimpan di cache, bukan di session, karena cookie
# session hanya bisa menampung sekitar 4 KB.
SESSION_DRIVER=file
SESSION_LIFETIME=120

# ---------------------------------------------------------------------------
# Cache
# ---------------------------------------------------------------------------
# Cache dipakai untuk menyimpan hasil konversi selama 15 menit.
#
# - "file"  : paling aman untuk hosting sederhana, tidak butuh server tambahan
# - "redis" : lebih baik untuk jumlah request tinggi
# - "array" : hanya untuk testing (data hilang tiap request)
CACHE_DRIVER=file
CACHE_STORE=file
CACHE_PREFIX=pdf-md-cache

# ---------------------------------------------------------------------------
# Batas upload
# ---------------------------------------------------------------------------
# Batas 15 MB ditegakkan oleh aplikasi (ConvertPdfRequest). Nilai di bawah ini
# adalah batas maksimal PHP, yang TIDAK BOLEH lebih kecil dari 15 MB, kalau
# tidak upload besar akan ditolak oleh PHP sebelum sampai ke aplikasi.
#
# Mengubah nilai ini berarti mengubah php.ini atau .htaccess milik server,
# bukan file .env.
# upload_max_filesize=15M
# post_max_size=16M

BROADCAST_DRIVER=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Frontend (Vite)
# ---------------------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"